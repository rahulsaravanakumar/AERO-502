<% content_for :title, "Dashboard · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow"><%= current_user.team&.name || "ALL TEAMS" %></p>
    <h1><%= current_user.member? ? "Your assignments" : "Project dashboard" %></h1>
    <p class="lede">Current status, ownership, and effort in one meeting-ready view.</p>
  </div>
  <% if current_user.leader? %>
    <%= link_to "Create task", new_task_path, class: "button" %>
  <% end %>
</div>

<section class="metrics" aria-label="Task status summary">
  <% Task.statuses.each_key do |status| %>
    <article class="metric">
      <span class="status-dot status-<%= status %>" aria-hidden="true"></span>
      <div>
        <strong><%= @status_counts[status] || 0 %></strong>
        <span><%= status.humanize %></span>
      </div>
    </article>
  <% end %>
  <article class="metric metric-emphasis">
    <span aria-hidden="true">Σ</span>
    <div>
      <strong><%= number_with_precision(@tasks.sum(&:total_actual_hours), precision: 1, strip_insignificant_zeros: true) %>h</strong>
      <span>Actual effort</span>
    </div>
  </article>
</section>

<section class="panel">
  <div class="section-heading">
    <h2>Task overview</h2>
    <%= link_to "Open full board", tasks_path %>
  </div>

  <% if @tasks.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Task</th>
            <th scope="col">Team</th>
            <th scope="col">Assigned members</th>
            <th scope="col">Status</th>
            <th scope="col">Estimated</th>
            <th scope="col">Actual</th>
            <th scope="col">Due</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <tr>
              <th scope="row"><%= link_to task.title, task %></th>
              <td><%= task.team.name %></td>
              <td><%= task.assignees.map(&:name).to_sentence.presence || "Unassigned" %></td>
              <td><span class="badge status-<%= task.status %>"><%= task.status.humanize %></span></td>
              <td><%= number_with_precision(task.estimated_hours, precision: 2, strip_insignificant_zeros: true) %>h</td>
              <td><%= number_with_precision(task.total_actual_hours, precision: 2, strip_insignificant_zeros: true) %>h</td>
              <td><%= task.due_date.to_fs(:long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h3>No tasks to show</h3>
      <p><%= current_user.member? ? "No work has been assigned to you yet." : "Create the first task for this project." %></p>
    </div>
  <% end %>
</section>

<% if current_user.leader? && @member_totals.any? %>
  <section class="panel">
    <h2>Member workload</h2>
    <div class="member-grid">
      <% User.where(id: @member_totals.keys).order(:name).each do |member| %>
        <article>
          <span><%= member.name %></span>
          <strong><%= number_with_precision(@member_totals[member.id], precision: 2, strip_insignificant_zeros: true) %> hours</strong>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
