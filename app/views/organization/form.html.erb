<% content_for :title, "#{@record.persisted? ? "Rename" : "New"} #{record_label.downcase} · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1><%= @record.persisted? ? "Rename #{record_label.downcase}" : "New #{record_label.downcase}" %></h1>
  </div>
</div>

<%= form_with model: @record, class: "panel task-form" do |form| %>
  <% if parent_field %>
    <% parent = parent_field.to_s.delete_suffix("_id").to_sym %>
    <% if @record.persisted? %>
      <p class="hint">In <%= @record.public_send(parent).full_name %>. A <%= record_label.downcase %> stays in the <%= parent %> it was created in.</p>
    <% else %>
      <div class="field">
        <%= form.label parent_field, parent.to_s.humanize %>
        <%= form.collection_select parent_field, parent_options, :id, :full_name, { prompt: "Select a #{parent}" }, required: true, **field_error_attributes(@record, parent) %>
        <%= field_error(@record, parent) %>
      </div>
    <% end %>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, **field_error_attributes(@record, :name) %>
    <%= field_error(@record, :name) %>
  </div>

  <% if @record.is_a?(Project) %>
    <% if @record.errors.any? %><div class="error-summary" role="alert"><%= @record.errors.full_messages.to_sentence %></div><% end %>
    <fieldset class="field">
      <legend>Participating subteams</legend>
      <p class="hint">Choose one or more subteams of the selected parent team. A task will identify its responsible subteam.</p>
      <%= hidden_field_tag "project[subteam_ids][]", "", id: nil %>
      <% Subteam.active.where(team_id: (@record.team_id || (current_user.chief_engineer? ? Team.select(:id) : [current_user.team_id]))).includes(:team).sort_by(&:full_name).each do |subteam| %>
        <label class="check-option"><%= check_box_tag "project[subteam_ids][]", subteam.id, (@selected_subteam_ids || @record.subteam_ids).include?(subteam.id), id: "project_subteam_#{subteam.id}" %><%= subteam.full_name %></label>
      <% end %>
      <%= field_error(@record, :subteams) %>
    </fieldset>
  <% end %>

  <div class="form-actions">
    <%= form.submit "Save #{record_label.downcase}", class: "button" %>
    <%= link_to "Cancel", organization_path, class: "button button-secondary" %>
  </div>
<% end %>
