<% content_for :title, "Organization · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1>Teams, subteams and projects</h1>
    <p class="lede">Each class (team) has subteams, and each subteam has projects. Tasks belong to a project. Select any name to see its tasks and hours.</p>
  </div>
  <% if current_user.chief_engineer? %>
    <%= link_to "New team", new_team_path, class: "button" %>
  <% end %>
</div>

<% if @teams.any? %>
  <div class="org-teams">
    <% @teams.each do |team| %>
      <% subteams = team.subteams.reject(&:archived?).sort_by(&:name) %>
      <% project_count = subteams.sum { |subteam| subteam.projects.count { |project| !project.archived? } } %>
      <article class="panel org-team" data-team="<%= team.id %>">
        <header class="org-team-header">
          <div>
            <h2><%= link_to team.name, team_path(team), class: "org-name" %></h2>
            <p class="muted"><%= pluralize(subteams.size, "subteam") %> · <%= pluralize(project_count, "project") %></p>
          </div>
          <% if current_user.chief_engineer? %>
            <%= render "manage_menu", label: "team #{team.name}", edit_path: edit_team_path(team), archive_path: archive_team_path(team) %>
          <% end %>
        </header>

        <% subteams.each do |subteam| %>
          <section class="org-subteam" data-subteam="<%= subteam.id %>">
            <div class="org-subteam-header">
              <h3><%= link_to subteam.name, subteam_path(subteam), class: "org-name" %></h3>
              <%= render "manage_menu", label: "subteam #{subteam.full_name}", edit_path: edit_subteam_path(subteam), archive_path: archive_subteam_path(subteam) %>
            </div>
            <% projects = subteam.projects.reject(&:archived?).sort_by(&:name) %>
            <% if projects.any? %>
              <ul class="org-projects">
                <% projects.each do |project| %>
                  <li>
                    <%= link_to project.name, project_path(project), class: "org-name" %>
                    <%= render "manage_menu", label: "project #{project.full_name}", edit_path: edit_project_path(project), archive_path: archive_project_path(project) %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="muted org-empty">No projects yet.</p>
            <% end %>
            <%= link_to "+ Add project", new_project_path(subteam_id: subteam.id), class: "add-action add-project", aria: { label: "Add project to #{subteam.full_name}" } %>
          </section>
        <% end %>

        <%= link_to "+ Add subteam", new_subteam_path(team_id: team.id), class: "add-action add-subteam", aria: { label: "Add subteam to #{team.name}" } %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="panel empty-state">
    <h2>No teams yet</h2>
    <p>The Chief Engineer can add the first team.</p>
  </div>
<% end %>

<section class="panel" data-archived>
  <h2>Archived</h2>
  <% if @archived.any? %>
    <ul class="plain-list">
      <% @archived.each do |record| %>
        <li class="org-row">
          <span>
            <%= link_to record.full_name, record %>
            <span class="muted"><%= record.model_name.human.downcase %></span>
          </span>
          <%= button_to "Restore", [ :restore, record ], method: :patch, class: "link-button", form_class: "row-actions",
                                                          aria: { label: "Restore #{record.model_name.human.downcase} #{record.full_name}" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">Nothing is archived.</p>
  <% end %>
</section>
