<% content_for :title, "Organization · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1>Teams, subteams and projects</h1>
    <p class="lede">Each class (team) has subteams, and each subteam has projects. Tasks belong to a project. Archived groups leave everyday lists but keep their tasks and hours.</p>
  </div>
  <% if current_user.chief_engineer? %>
    <%= link_to "New team", new_team_path, class: "button" %>
  <% end %>
</div>

<% if @teams.any? %>
  <div class="org-teams">
    <% @teams.each do |team| %>
      <article class="panel org-team" data-team="<%= team.id %>">
        <div class="section-heading">
          <h2><%= link_to team.name, team_path(team) %></h2>
          <% if current_user.chief_engineer? %>
            <div class="row-actions">
              <%= link_to "Rename", edit_team_path(team), aria: { label: "Rename team #{team.name}" } %>
              <%= button_to "Archive", archive_team_path(team), method: :patch, class: "link-button", aria: { label: "Archive team #{team.name}" } %>
            </div>
          <% end %>
        </div>

        <% team.subteams.select { |subteam| !subteam.archived? }.sort_by(&:name).each do |subteam| %>
          <section class="org-subteam-block" data-subteam="<%= subteam.id %>">
            <div class="org-row">
              <h3><%= link_to subteam.name, subteam_path(subteam) %></h3>
              <div class="row-actions">
                <%= link_to "Rename", edit_subteam_path(subteam), aria: { label: "Rename subteam #{subteam.full_name}" } %>
                <%= button_to "Archive", archive_subteam_path(subteam), method: :patch, class: "link-button", aria: { label: "Archive subteam #{subteam.full_name}" } %>
              </div>
            </div>
            <ul class="plain-list org-projects">
              <% subteam.projects.select { |project| !project.archived? }.sort_by(&:name).each do |project| %>
                <li class="org-row">
                  <%= link_to project.name, project_path(project) %>
                  <div class="row-actions">
                    <%= link_to "Rename", edit_project_path(project), aria: { label: "Rename project #{project.full_name}" } %>
                    <%= button_to "Archive", archive_project_path(project), method: :patch, class: "link-button", aria: { label: "Archive project #{project.full_name}" } %>
                  </div>
                </li>
              <% end %>
            </ul>
            <%= link_to "Add project", new_project_path(subteam_id: subteam.id), class: "add-link", aria: { label: "Add project to #{subteam.full_name}" } %>
          </section>
        <% end %>
        <%= link_to "Add subteam", new_subteam_path(team_id: team.id), class: "add-link", aria: { label: "Add subteam to #{team.name}" } %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="panel empty-state">
    <h2>No teams yet</h2>
    <p>The Chief Engineer can add the first team.</p>
  </div>
<% end %>

<section class="panel" data-archived>
  <h2>Archived</h2>
  <% if @archived.any? %>
    <ul class="plain-list">
      <% @archived.each do |record| %>
        <li class="org-row">
          <span>
            <%= link_to record.full_name, record %>
            <span class="muted"><%= record.model_name.human.downcase %></span>
          </span>
          <%= button_to "Restore", [ :restore, record ], method: :patch, class: "link-button", form_class: "row-actions",
                                                          aria: { label: "Restore #{record.model_name.human.downcase} #{record.full_name}" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">Nothing is archived.</p>
  <% end %>
</section>
