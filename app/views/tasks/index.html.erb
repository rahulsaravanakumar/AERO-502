<% content_for :title, "#{@view == "mine" ? "My Tasks" : "Task Board"} · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow"><%= current_user.team&.name || "ALL TEAMS" %></p>
    <h1><%= @view == "mine" ? "My Tasks" : "Task Board" %></h1>
  </div>
  <div class="segmented" aria-label="Task view">
    <%= link_to "Board", tasks_path, class: @view == "board" ? "active" : nil %>
    <%= link_to "My Tasks", tasks_path(view: "mine"), class: @view == "mine" ? "active" : nil %>
  </div>
</div>

<%= form_with scope: :filter, url: tasks_path, method: :get, class: "panel filter-bar", aria: { label: "Search and filter tasks" } do |form| %>
  <% if @view == "mine" %>
    <%= hidden_field_tag :view, "mine", id: nil %>
  <% end %>
  <%= render "tasks/filter_fields", form: form %>
  <% if @hours %>
    <%= hidden_field_tag :from, @hours.from, id: nil if @hours.from %>
    <%= hidden_field_tag :to, @hours.to, id: nil if @hours.to %>
  <% end %>
  <div class="filter-actions">
    <%= form.submit "Apply", class: "button", name: nil %>
    <%= link_to "Clear", tasks_path(view: (@view if @view == "mine"), filter: { q: "" }), class: "button button-secondary" %>
  </div>
<% end %>

<% if @tasks.none? && task_filter.active? && Task.accessible_to(current_user).exists? %>
  <div class="panel empty-state">
    <h2>No tasks found</h2>
    <p>No tasks match your search or filters.</p>
  </div>
<% elsif @tasks.any? %>
  <% if @hours %>
    <p class="board-summary" data-board-summary>
      <strong class="<%= "summary-alert" if @tasks.any?(&:overdue?) %>"><%= @tasks.count(&:overdue?) %> overdue</strong>
      <span aria-hidden="true">·</span>
      <%= number_with_precision(@hours.total_actual, precision: 1, strip_insignificant_zeros: true) %>h actual of
      <%= number_with_precision(@hours.total_estimate, precision: 1, strip_insignificant_zeros: true) %>h estimated
      <span aria-hidden="true">·</span>
      <%= link_to "Hours by member", "#hours" %>
    </p>
  <% end %>
  <div class="task-board">
    <% Task.statuses.each_key do |status| %>
      <section class="task-column" aria-labelledby="<%= status %>-heading">
        <div class="column-heading">
          <h2 id="<%= status %>-heading"><%= status.humanize %></h2>
          <span><%= @tasks.count { |task| task.status == status } %></span>
        </div>
        <% @tasks.select { |task| task.status == status }.each do |task| %>
          <article class="task-card">
            <div class="task-meta">
              <span><%= task.team.name %></span>
              <span>
                <% if task.overdue? %><span class="overdue-label">Overdue</span><% end %>
                Due <%= task.due_date.to_fs(:short) %>
              </span>
            </div>
            <h3><%= link_to task.title, task %></h3>
            <p><%= truncate(task.description, length: 110) %></p>
            <div class="task-foot">
              <span><%= task.assignees.map(&:name).to_sentence.presence || "Unassigned" %></span>
              <strong><%= number_with_precision(task.total_actual_hours, precision: 1, strip_insignificant_zeros: true) %>/<%= number_with_precision(task.estimated_hours, precision: 1, strip_insignificant_zeros: true) %>h</strong>
            </div>
          </article>
        <% end %>
      </section>
    <% end %>
  </div>
  <%= render "tasks/hours", hours: @hours if @hours %>
<% else %>
  <div class="panel empty-state">
    <h2>No tasks found</h2>
    <p><%= @view == "mine" ? "No tasks are assigned to you." : "There are no permitted tasks on this board." %></p>
  </div>
<% end %>
