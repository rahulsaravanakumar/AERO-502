<% content_for :title, "Change role for #{@user.name} · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1><%= @user.name %></h1>
    <p class="lede"><%= @user.email %></p>
  </div>
</div>

<%= form_with model: @user, class: "panel task-form" do |form| %>
  <% if @user.errors.any? %>
    <div class="error-summary" role="alert">
      <h2><%= pluralize(@user.errors.count, "error") %> prevented this change from being saved</h2>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= form.label :role %>
      <%= form.select :role, User::ROLE_LABELS.map { |value, label| [ label, value ] }, {}, **field_error_attributes(@user, :role) %>
      <%= field_error(@user, :role) %>
    </div>
    <div class="field">
      <%= form.label :team_id, "Team" %>
      <%= form.collection_select :team_id, Team.order(:name), :id, :name, { include_blank: "No team (Chief Engineer only)" }, **field_error_attributes(@user, :team) %>
      <%= field_error(@user, :team) %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit "Save role", class: "button" %>
    <%= link_to "Cancel", users_path, class: "button button-secondary" %>
  </div>
<% end %>
