<% content_for :title, "Change role for #{@user.name} · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1><%= @user.name %></h1>
    <p class="lede"><%= @user.email %></p>
  </div>
</div>

<%= form_with model: @user, class: "panel task-form" do |form| %>
  <% if @user.errors.any? %>
    <div class="error-summary" role="alert">
      <h2><%= pluralize(@user.errors.count, "error") %> prevented this change from being saved</h2>
    </div>
  <% end %>

  <%= render "role_fields", form: form, user: @user %>

  <div class="form-actions">
    <%= form.submit "Save role", class: "button" %>
    <%= link_to "Cancel", users_path, class: "button button-secondary" %>
  </div>
<% end %>
