<% content_for :title, "People · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow">ADMINISTRATION</p>
    <h1>People and roles</h1>
    <p class="lede">Change a person's role or team. New permissions apply the next time they load a page.</p>
  </div>
</div>

<section class="panel">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <th scope="col">Role</th>
          <th scope="col">Team</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <th scope="row"><%= user.name %></th>
            <td><%= user.email %></td>
            <td><%= user.role_label %></td>
            <td><%= user.team&.name || "All teams" %></td>
            <td><%= link_to "Change role", edit_user_path(user), aria: { label: "Change role for #{user.name}" } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
